{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/estimation-coach/scenario.v1.schema.json",
  "title": "Estimation Coach Scenario v1",
  "type": "object",
  "required": [
    "scenario_version",
    "id",
    "type",
    "difficulty",
    "primary_skill",
    "skills"
  ],
  "properties": {
    "scenario_version": {
      "const": 1,
      "type": "integer"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "type": {
      "enum": [
        "bidding",
        "play"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "difficulty": {
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "primary_skill": {
      "type": "string",
      "minLength": 1
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "player_position": {
      "enum": [
        "north",
        "east",
        "south",
        "west"
      ]
    },
    "hand": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(A|K|Q|J|10|[2-9])[SHDC]$"
      }
    },
    "previous_actions": {
      "type": "array"
    },
    "allowed_decisions": {
      "type": "object"
    },
    "evaluations": {
      "type": "array"
    },
    "author_notes": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "nonblank": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "seat": {
      "enum": [
        "north",
        "east",
        "south",
        "west"
      ]
    },
    "suit": {
      "enum": [
        "spades",
        "hearts",
        "diamonds",
        "clubs"
      ]
    },
    "tricks": {
      "type": "integer",
      "minimum": 4,
      "maximum": 13
    },
    "previousAction": {
      "type": "object",
      "required": [
        "action",
        "player"
      ],
      "properties": {
        "action": {
          "enum": [
            "pass",
            "dash",
            "bid",
            "enter"
          ]
        },
        "tricks": {
          "$ref": "#/$defs/tricks"
        },
        "trump": {
          "$ref": "#/$defs/trump"
        },
        "player": {
          "$ref": "#/$defs/seat"
        }
      },
      "if": {
        "properties": {
          "action": {
            "const": "bid"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "tricks",
          "trump"
        ]
      },
      "else": {
        "properties": {
          "tricks": false,
          "trump": false
        }
      }
    },
    "decision": {
      "type": "object",
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "enum": [
            "dash",
            "bid",
            "enter"
          ]
        },
        "tricks": {
          "$ref": "#/$defs/tricks"
        },
        "trump": {
          "$ref": "#/$defs/trump"
        }
      },
      "if": {
        "properties": {
          "action": {
            "const": "bid"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "tricks",
          "trump"
        ]
      },
      "else": {
        "properties": {
          "tricks": false,
          "trump": false
        }
      }
    },
    "allowedDecisions": {
      "type": "object",
      "required": [
        "dash",
        "bids",
        "trumps"
      ],
      "properties": {
        "dash": {
          "const": false
        },
        "bids": {
          "type": "object",
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "$ref": "#/$defs/tricks"
            },
            "max": {
              "$ref": "#/$defs/tricks"
            }
          }
        },
        "trumps": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/trump"
          }
        },
        "enter": {
          "const": false
        }
      }
    },
    "feedback": {
      "type": "object",
      "required": [
        "title",
        "summary",
        "points"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/nonblank"
        },
        "summary": {
          "$ref": "#/$defs/nonblank"
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonblank"
          }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "required": [
        "decision",
        "rating",
        "feedback"
      ],
      "properties": {
        "decision": {
          "$ref": "#/$defs/decision"
        },
        "rating": {
          "enum": [
            "strong",
            "reasonable",
            "risky",
            "weak"
          ]
        },
        "feedback": {
          "$ref": "#/$defs/feedback"
        }
      }
    },
    "trump": {
      "enum": [
        "clubs",
        "diamonds",
        "hearts",
        "spades",
        "no_trump"
      ]
    },
    "preDecisions": {
      "type": "object",
      "required": [
        "dash",
        "enter"
      ],
      "properties": {
        "dash": {
          "type": "boolean"
        },
        "enter": {
          "type": "boolean"
        },
        "bids": false,
        "trumps": false
      },
      "anyOf": [
        {
          "properties": {
            "dash": {
              "const": true
            }
          }
        },
        {
          "properties": {
            "enter": {
              "const": true
            }
          }
        }
      ]
    },
    "card": {
      "type": "string",
      "pattern": "^(A|K|Q|J|10|[2-9])[SHDC]$"
    },
    "playCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 13
    },
    "seatPlay": {
      "type": "object",
      "required": [
        "player",
        "card"
      ],
      "properties": {
        "player": {
          "$ref": "#/$defs/seat"
        },
        "card": {
          "$ref": "#/$defs/card"
        }
      },
      "additionalProperties": false
    },
    "auctionBid": {
      "type": "object",
      "required": [
        "tricks",
        "trump"
      ],
      "properties": {
        "tricks": {
          "$ref": "#/$defs/tricks"
        },
        "trump": {
          "$ref": "#/$defs/trump"
        }
      },
      "additionalProperties": false
    },
    "playSituation": {
      "type": "object",
      "required": [
        "leader",
        "current_trick",
        "trump",
        "trick_estimate",
        "tricks_taken"
      ],
      "properties": {
        "leader": {
          "$ref": "#/$defs/seat"
        },
        "current_trick": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/seatPlay"
          }
        },
        "trump": {
          "$ref": "#/$defs/trump"
        },
        "trick_estimate": {
          "$ref": "#/$defs/playCount"
        },
        "tricks_taken": {
          "type": "object",
          "required": [
            "north",
            "east",
            "south",
            "west"
          ],
          "properties": {
            "north": {
              "$ref": "#/$defs/playCount"
            },
            "east": {
              "$ref": "#/$defs/playCount"
            },
            "south": {
              "$ref": "#/$defs/playCount"
            },
            "west": {
              "$ref": "#/$defs/playCount"
            }
          },
          "additionalProperties": false
        },
        "auction_bid": {
          "$ref": "#/$defs/auctionBid"
        },
        "observed_tricks": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "$ref": "#/$defs/seatPlay"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "playEvaluation": {
      "type": "object",
      "required": [
        "decision",
        "rating",
        "feedback"
      ],
      "properties": {
        "decision": {
          "type": "object",
          "required": [
            "action",
            "card"
          ],
          "properties": {
            "action": {
              "const": "play"
            },
            "card": {
              "$ref": "#/$defs/card"
            }
          },
          "additionalProperties": false
        },
        "rating": {
          "enum": [
            "strong",
            "reasonable",
            "risky",
            "weak"
          ]
        },
        "feedback": {
          "$ref": "#/$defs/feedback"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "bidding"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "title",
          "player_position",
          "hand",
          "previous_actions",
          "allowed_decisions",
          "evaluations",
          "rules_version",
          "bidding_phase",
          "dash_players"
        ],
        "properties": {
          "title": {
            "$ref": "#/$defs/nonblank"
          },
          "primary_skill": {
            "$ref": "#/$defs/nonblank"
          },
          "skills": {
            "items": {
              "$ref": "#/$defs/nonblank"
            }
          },
          "hand": {
            "minItems": 13,
            "maxItems": 13
          },
          "previous_actions": {
            "items": {
              "$ref": "#/$defs/previousAction"
            }
          },
          "evaluations": {
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/evaluation"
            }
          },
          "author_notes": {
            "$ref": "#/$defs/nonblank"
          },
          "rules_version": {
            "const": "game_rules_v1"
          },
          "bidding_phase": {
            "enum": [
              "pre_bidding",
              "normal"
            ]
          },
          "dash_players": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/seat"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "bidding_phase": {
                  "const": "pre_bidding"
                }
              }
            },
            "then": {
              "properties": {
                "allowed_decisions": {
                  "$ref": "#/$defs/preDecisions"
                },
                "previous_actions": {
                  "items": {
                    "properties": {
                      "action": {
                        "enum": [
                          "dash",
                          "enter"
                        ]
                      }
                    }
                  }
                },
                "evaluations": {
                  "items": {
                    "properties": {
                      "decision": {
                        "properties": {
                          "action": {
                            "enum": [
                              "dash",
                              "enter"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "allowed_decisions": {
                  "$ref": "#/$defs/allowedDecisions"
                },
                "previous_actions": {
                  "items": {
                    "properties": {
                      "action": {
                        "enum": [
                          "pass",
                          "bid"
                        ]
                      }
                    }
                  }
                },
                "evaluations": {
                  "items": {
                    "properties": {
                      "decision": {
                        "properties": {
                          "action": {
                            "enum": [
                              "bid"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "play"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "title",
          "rules_version",
          "player_position",
          "hand",
          "situation",
          "evaluations"
        ],
        "properties": {
          "title": {
            "$ref": "#/$defs/nonblank"
          },
          "primary_skill": {
            "$ref": "#/$defs/nonblank"
          },
          "skills": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/nonblank"
            }
          },
          "rules_version": {
            "const": "game_rules_v1"
          },
          "hand": {
            "type": "array",
            "minItems": 1,
            "maxItems": 13,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/card"
            }
          },
          "situation": {
            "$ref": "#/$defs/playSituation"
          },
          "evaluations": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/playEvaluation"
            }
          },
          "author_notes": {
            "$ref": "#/$defs/nonblank"
          },
          "allowed_decisions": false,
          "previous_actions": false,
          "bidding_phase": false,
          "dash_players": false
        }
      }
    }
  ]
}
